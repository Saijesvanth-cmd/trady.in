APP_ENV=development
DATABASE_URL=sqlite:///./trady_dev.db

# Phase 3 (AI). Put the model ID from Anthropic's docs here; never hardcode it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# demo = SIMULATED data, no credentials needed. upstox arrives in Phase 2.
MARKET_DATA_PROVIDER=demo
# Upstox Analytics Token (read-only market data, no daily re-login). Phase 2.
UPSTOX_ANALYTICS_TOKEN=

DEFAULT_PAPER_BALANCE=100000
PAPER_TRADING_ENABLED=true
# The app refuses to start if this is true.
LIVE_ORDER_EXECUTION_ENABLED=false

MARKET_DATA_CACHE_SECONDS=60
MAX_UPLOAD_MB=5
CORS_ORIGINS=http://localhost:3000
